# ---------------------------------------------------------------------------------------------------------------
# DEVELOPMENT values. They match backend/src/main/resources/application-local.yml, so with this file copied to
# `.env` you can run only the infrastructure in Docker and the backend from your IDE:
#
#     cp .env.example .env
#     docker compose up -d postgres redis kafka s3 mailpit
#     cd backend && mvn spring-boot:run
#
# scripts/up.sh does NOT use this file: it generates random secrets into ~/.config/insurai-platform/compose.env.
# Never deploy with these values.
# ---------------------------------------------------------------------------------------------------------------

# --- required (compose refuses to start without them) ---
PLATFORM_DB_PASSWORD=insurai-local
PLATFORM_S3_ACCESS_KEY=local-s3-access
PLATFORM_S3_SECRET_KEY=local-s3-secret-key
PLATFORM_JWT_SECRET=local-only-jwt-secret-do-not-use-in-prod-0123456789
PLATFORM_ADMIN_EMAIL=admin@insurai.local
PLATFORM_ADMIN_PASSWORD=LocalAdmin-1
PLATFORM_PARTY_HMAC_KEY=local-only-party-hmac-key-do-not-use-in-prod
FRAUD_ADMIN_TOKEN=local-dev-admin-token

# --- optional: behaviour ---
# Core-module staff bootstrap: e-mails that start as MANAGER (comma separated).
#PLATFORM_BOOTSTRAP_MANAGERS=manager@demo.example.test
# Origins allowed to call the API from a browser (comma separated patterns). Add your deployed frontend here.
#PLATFORM_CORS_ORIGINS=http://localhost:5173
# Fraud dashboard, its WebSocket and Swagger UI without a token. Development only.
#PLATFORM_OPEN_DEV_ENDPOINTS=false

# --- optional: portal integrations (leave unset to run without them) ---
#COHERE_API_KEY=
#SUPABASE_URL=
#SUPABASE_ACCESS_KEY=
#SUPABASE_SECRET_KEY=
#SUPABASE_BUCKET=Insur_AI
#SUPABASE_REGION=ap-south-1

# --- optional: real SMTP instead of the Mailpit catch-all ---
#PLATFORM_SMTP_HOST=smtp.gmail.com
#PLATFORM_SMTP_PORT=587
#PLATFORM_SMTP_USER=
#PLATFORM_SMTP_PASSWORD=
#PLATFORM_SMTP_AUTH=true
#PLATFORM_SMTP_STARTTLS=true
#PLATFORM_MAIL_FROM=claims@your-domain.example

# --- optional: published ports ---
#BACKEND_PORT=8080
#FRONTEND_PORT=5173
#VITE_API_BASE_URL=http://localhost:8080
