# Frontend build-time configuration (Vite). Copy to .env.local for local development.

# Base URL of the platform backend. NO trailing slash and NO "/api" suffix: the UI calls
# ${VITE_API_BASE_URL}/auth/login, ${VITE_API_BASE_URL}/admin/..., and so on.
# The backend must list this site's origin in PLATFORM_CORS_ORIGINS.
VITE_API_BASE_URL=http://localhost:8080

VITE_APP_NAME=InsurAI
